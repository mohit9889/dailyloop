NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Exact browser origin. Use your Render https://...onrender.com origin when hosted.
APP_ORIGIN=http://127.0.0.1:5173
# Session-pooler connection for dailyloop_api, NOT postgres or a service role.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate locally: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
# Migration identity only, used by npm run db:migrate -w @dailyloop/backend.
MIGRATION_DATABASE_URL=

# Replace this non-routable placeholder before public launch.
SUPPORT_EMAIL=support@dailyloop.example

# Keep 0 normally; set 1 and restart to drain app traffic for operator maintenance.
MAINTENANCE_MODE=0
# Operator only; never include in Render serving env or any frontend. Needed only for verified account erasure.
SUPABASE_SERVICE_ROLE_KEY=
